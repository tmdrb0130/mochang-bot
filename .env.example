OPENROUTER_API_KEY=sk-or-v1-...

# --- 자료조사 소스 API 키 (docs/RESEARCH_PLAN.md 3단계). 발급되는 대로 채우고 mochang-api 재시작 ---
# 네이버 검색 API — NAVER API HUB (ncloud 콘솔 > NAVER API HUB > Application > 검색). developers.naver.com 은 신규 종료.
# 뉴스/블로그/웹문서 공용 (전문자료는 2026-07 종료). 키 들어오면 naver → ddgs 순으로 자동 전환
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# 공공데이터포털 (data.go.kr) — 한 계정의 '일반 인증키' 하나를 활용신청한 API 전부에 공용 (SEMAS/KSTARTUP 따로 두지 않음).
#   활용신청: 상가(상권)정보 https://www.data.go.kr/data/15012005/openapi.do / K-Startup https://www.data.go.kr/data/15125364/openapi.do
#   마이페이지 > 오픈API > 활용신청 현황에 Encoding/Decoding 두 키 표시 → **Decoding 키**를 넣는다 (httpx 가 params 로 인코딩).
#   오픈 전 운영계정 전환 신청 (개발계정 1,000회/일)
DATA_GO_KR_API_KEY=
# 국가통계포털 KOSIS OpenAPI (kosis.kr/openapi)
KOSIS_API_KEY=
# 한국은행 ECOS (ecos.bok.or.kr)
ECOS_API_KEY=
# KCI OpenAPI (kci.go.kr/kciportal/po/openapi) — 국내 학술 근거. 해외(OpenAlex·Semantic Scholar)는 키 불필요
KCI_API_KEY=
# 특허 KIPRIS Plus (plus.kipris.or.kr) — 기술 트랙용, 승인에 며칠
KIPRIS_API_KEY=
